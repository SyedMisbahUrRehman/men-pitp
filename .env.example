# ===========================================
# Copy this file to .env and fill in values
# ===========================================


# Port the Express app listens on (default: 3000)
PORT=3000

# MongoDB
# Connection string for your MongoDB instance.
# For local: mongodb://localhost:27017/your-db-name
# For Atlas: mongodb+srv://user:password@cluster.mongodb.net/your-db-name
MONGODB_URI=mongodb://localhost:27017/student_db

# Optional: set to "development" for verbose logs (if you add logging later)
NODE_ENV=development
